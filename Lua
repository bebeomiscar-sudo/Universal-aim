local origNamecall
origNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if State.SilentAim and method == "FireServer" then
        local args   = { ... }
        local target = getClosestToMouse(360)
        if target then
            local camPos = wspace.CurrentCamera.CFrame.Position
            local lookCF = CFrame.lookAt(camPos, target.Position)
            local replaced = false
            for i, arg in ipairs(args) do
                if typeof(arg) == "Instance" and arg:IsA("BasePart") then
                    args[i] = target; replaced = true
                elseif typeof(arg) == "Vector3" and arg.Magnitude > 5 then
                    args[i] = target.Position; replaced = true
                elseif typeof(arg) == "CFrame" and arg.Position.Magnitude > 5 then
                    args[i] = lookCF; replaced = true
                end
            end
            if replaced then return self:FireServer(unpack(args)) end
        end
    end
    return origNamecall(self, ...)
end)

