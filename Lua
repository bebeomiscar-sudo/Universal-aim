-- ═══════════════════════════════════════════
-- SILENT AIM
-- ═══════════════════════════════════════════
local saTarget      = nil
local saHookApplied = false
local saHookIdx     = nil
local saConn        = nil

local function saGetTarget()
    local c = getCenter()
    local best, bd = nil, SACFG.IgnoreFOV and math.huge or SACFG.FOVSize
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if SACFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character; if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = getBestPart(ch, SACFG.TargetPart)
        if not part then continue end
        if SACFG.VisCheck and not isVisible(part) then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then
            bd   = d
            best = {part = part, char = ch}
        end
    end
    return best
end

local function startSAHook()
    if not saHookApplied then
        local ok = pcall(function()
            saHookIdx = hookmetamethod(game, "__index", newcclosure(function(self, idx, ...)
                if SACFG.On and not checkcaller()
                and idx == "ViewportSize" and self == workspace.CurrentCamera then
                    if saTarget and math.random(1, 100) <= SACFG.HitChance then
                        local pos, on = workspace.CurrentCamera:WorldToViewportPoint(saTarget)
                        if on then return Vector2.new(pos.X * 2, pos.Y * 2) end
                    end
                end
                return saHookIdx(self, idx, ...)
            end))
        end)
        if ok then
            saHookApplied = true
            Library:Notify("Silent Aim hook applied ✓", 3)
        else
            Library:Notify("Hook failed — executor may not support it", 4)
        end
    end

    if saConn then saConn:Disconnect() end
    saConn = RunService.Heartbeat:Connect(function()
        if not SACFG.On then saTarget = nil; return end
        local result = saGetTarget()
        if not result then saTarget = nil; return end

        if SACFG.JumpPredict then
            saTarget = getPredictedPosition(result.char)
                or result.part.Position
        else
            saTarget = result.part.Position
        end
    end)
end

local function stopSA()
    SACFG.On = false
    saTarget  = nil
    if saConn then saConn:Disconnect(); saConn = nil end
end

-- ═══════════════════════════════════════════
-- AIMBOT
-- Speed        = base smoothness
-- SpeedScale   = how much FOV distance
--                affects smoothness (0-100)
-- MaxLockOn    = max seconds to lock one target
-- ReactionTime = delay before locking (ms)
-- ═══════════════════════════════════════════
local lockedTarget  = nil
local lockTimer     = 0
local reactionTimer = 0
local isInReaction  = false

local function isTargetValid(part)
    if not part or not part.Parent then return false end
    local hum = part.Parent:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimCFG.VisCheck and not isVisible(part) then return false end
    if AimCFG.TeamCheck then
        local p = Players:GetPlayerFromCharacter(part.Parent)
        if p and isSameTeam(p) then return false end
    end
    local sp, on = camera:WorldToScreenPoint(part.Position)
    if not on then return false end
    local d = (Vector2.new(sp.X, sp.Y) - getCenter()).Magnitude
    if d > AimCFG.FOV then return false end
    return true
end

local function findAimTarget()
    local c = getCenter()
    local best, bd = nil, AimCFG.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if AimCFG.TeamCheck and isSameTeam(p) then continue end
        local ch = p.Character; if not ch then continue end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = getBestPart(ch, AimCFG.TargetPart)
        if not part then continue end
        if AimCFG.VisCheck and not isVisible(part) then continue end
        local sp, on = camera:WorldToScreenPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
        if d < bd then
            bd   = d
            best = part
        end
    end
    return best
end

-- Aimbot runs on RenderStepped at Camera+2
-- so it overrides the game camera at Camera+1
RunService:BindToRenderStep("univ_aimbot", Enum.RenderPriority.Camera.Value + 2, function(dt)
    camera = workspace.CurrentCamera
    if not AimCFG.On then return end

    -- Reaction time delay
    if isInReaction then
        reactionTimer = reactionTimer - dt
        if reactionTimer <= 0 then
            isInReaction = false
        else
            return
        end
    end

    -- Revalidate existing lock
    if lockedTarget and not isTargetValid(lockedTarget) then
        lockedTarget = nil
        lockTimer    = 0
    end

    -- Find new target if no lock
    if not lockedTarget then
        local newT = findAimTarget()
        if newT then
            lockedTarget  = newT
            lockTimer     = 0
            isInReaction  = true
            reactionTimer = AimCFG.ReactionTime / 1000
        end
    end

    if not lockedTarget then return end

    -- Max lock on time
    lockTimer = lockTimer + dt
    if lockTimer > AimCFG.MaxLockOn then
        lockedTarget = nil
        lockTimer    = 0
        return
    end

    -- Calculate smooth speed
    -- SpeedScale makes smoothness increase the
    -- further the target is from center
    local c      = getCenter()
    local sp2, on2 = camera:WorldToScreenPoint(lockedTarget.Position)
    if not on2 then return end
    local screenDist = (Vector2.new(sp2.X, sp2.Y) - c).Magnitude
    local scaleFactor = 1 + (screenDist / math.max(AimCFG.FOV, 1))
        * (AimCFG.SpeedScale / 100)
    local smooth = math.clamp(1 / (AimCFG.Speed * scaleFactor), 0.01, 1)

    -- Move camera toward target
    local cp     = camera.CFrame.Position
    local dir    = (lockedTarget.Position - cp).Unit
    local tPitch = math.asin(math.clamp(dir.Y, -1, 1))
    local tYaw   = math.atan2(-dir.X, -dir.Z)
    local cPitch, cYaw = camera.CFrame:ToOrientation()
    local nPitch = cPitch + angleDiff(cPitch, tPitch) * smooth
    local nYaw   = cYaw   + angleDiff(cYaw,   tYaw)   * smooth

    pcall(function()
        camera.CFrame = CFrame.new(cp)
            * CFrame.Angles(0, nYaw, 0)
            * CFrame.Angles(nPitch, 0, 0)
    end)
end)

local function stopAimbot()
    AimCFG.On    = false
    lockedTarget = nil
    lockTimer    = 0
    reactionTimer = 0
    isInReaction = false
end

